{
  "name": "my-website-template",
  "private": true,
  "description": "Static site template",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:staging": "bun scripts/build-staging.mjs",
    "check:staging": "bun run build:staging && bun scripts/check-staging.mjs",
    "lint:docs": "textlint README.md AGENTS.md \"docs/**/*.md\"",
    "test": "bun test"
  },
  "devDependencies": {
    "textlint": "^15.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  }
}
